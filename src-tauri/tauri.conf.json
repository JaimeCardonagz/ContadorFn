{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FortniteChestCounter",
  "version": "0.1.0",
  "identifier": "io.github.jaimecardonagz.fortnitechestcounter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fortnite Chest Counter",
        "width": 340,
        "height": 420,
        "minWidth": 260,
        "minHeight": 200,
        "alwaysOnTop": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "mainBinaryName": "FortniteChestCounter"
}
