{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FortniteChestCounter",
  "version": "1.1.1",
  "identifier": "io.github.jaimecardonagz.fortnitechestcounter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build",
    "features": [
      "bundled-sqlite"
    ]
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "mainBinaryName": "FortniteChestCounter"
}
