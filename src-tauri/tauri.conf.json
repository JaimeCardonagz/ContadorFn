{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FortniteChestCounter",
  "version": "1.0.1",
  "identifier": "io.github.jaimecardonagz.fortnitechestcounter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build",
    "features": [
      "bundled-sqlite"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fortnite Chest Counter",
        "width": 440,
        "height": 620,
        "minWidth": 320,
        "minHeight": 360,
        "resizable": true
      },
      {
        "label": "overlay",
        "url": "/overlay",
        "title": "Fortnite Chest Counter - contador",
        "width": 250,
        "height": 104,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "mainBinaryName": "FortniteChestCounter"
}
